{
  "name": "full-stack-template",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:infra:start": "docker-compose up -d --wait",
    "dev:infra:stop": "docker-compose stop",
    "dev:infra:down": "docker-compose down -v --remove-orphans",
    "commitlint": "commitlint --edit $1",
    "lint": "eslint . --fix",
    "format": "prettier --write 'frontend/**/*.{ts,tsx,js,jsx}' 'backend/**/*.{ts,js}'",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  },
  "lint-staged": {
    "**/*.(js|jsx|ts|tsx)": [
      "eslint --fix",
      "npm run format"
    ]
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
