{
  "name": "full-stack-template",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:infra:start": "docker-compose up -d --wait",
    "dev:infra:stop": "docker-compose stop",
    "dev:infra:down": "docker-compose down -v --remove-orphans",
    "commitlint": "commitlint --edit $1",
    "lint": "turbo lint --continue",
    "lint:fix": "turbo lint --continue -- --fix",
    "check-types": "turbo check-types --continue",
    "format": "prettier --check 'apps/**/*.{ts,tsx,js,jsx,mjs}' 'packages/**/*.{ts,js,mjs}' 'infra/**/*.{ts,js,mjs}'",
    "format:fix": "prettier --write 'apps/**/*.{ts,tsx,js,jsx,mjs}' 'packages/**/*.{ts,js,mjs}' 'infra/**/*.{ts,js,mjs}'",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "turbo": "^2.10.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  },
  "lint-staged": {
    "(apps|packages|infra)/**/*.(js|jsx|ts|tsx|mjs)": [
      "pnpm lint:fix",
      "pnpm format:fix"
    ]
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@12.6.0"
}
