{
  "name": "@repo/db",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "build": "dotenv run -f .env.development -- pnpm db:generate && tsc",
    "postinstall": "pnpm db:generate && tsc",
    "dev": "tsc --watch",
    "db:sync": "dotenv run -f .env.development -- prisma db push && dotenv run -f .env.development -- prisma generate",
    "db:migration:gen": "dotenv run -f .env.development -- prisma migrate dev --name $npm_config_name",
    "db:migration:run": "dotenv run -f .env.development -- prisma migrate dev",
    "db:generate": "prisma generate",
    "db:reset": "dotenv run -f .env.development -- prisma migrate reset",
    "db:seed:run": "dotenv run -f .env.development -- prisma db seed",
    "db:studio": "dotenv run -f .env.development -- prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/parser": "^8.70.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.10.0"
  }
}
