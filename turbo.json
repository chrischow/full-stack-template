{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*", "tsconfig*.json", "vite.config.*"],
      "outputs": ["dist/**"],
      "passThroughEnv": ["VITE_*"]
    },
    "lint": {
      "cache": true,
      "inputs": ["src/**/*.{ts,tsx}", "tsconfig*.json", "vite.config.*", "eslint.config.mjs"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
