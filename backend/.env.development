NODE_ENV=development
APP_PORT=8080
APP_DOMAIN=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Session
SESSION_NAME=app.sid
SESSION_SECRET=session-secret
SESSION_COOKIE_MAX_AGE=86400000

# OAuth
OAUTH_BASE_URL=http://localhost:5556/dex
OAUTH_CLIENT_ID=full-stack-app
OAUTH_CLIENT_SECRET=auth-client-secret
OAUTH_CLIENT_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/redirect

# OTP
OTP_REQUEST_TIMEOUT_SECONDS=60
OTP_VALIDITY_SECONDS=300
OTP_MAX_RETRIES=5

# AWS
AWS_REGION=AWS_REGION
AWS_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY
AWS_SES_ENDPOINT=http://localhost:8005