NODE_ENV=development
APP_PORT=8080
APP_DOMAIN=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Session
SESSION_NAME=app.sid
SESSION_SECRET=session-secret
SESSION_COOKIE_MAX_AGE=86400000

# Auth
OAUTH_BASE_URL=http://localhost:5556/dex
OAUTH_CLIENT_ID=full-stack-app
OAUTH_CLIENT_SECRET=auth-client-secret
OAUTH_CLIENT_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/redirect